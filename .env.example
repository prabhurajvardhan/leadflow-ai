# LeadFlow AI - Environment Configuration Example
# Copy this file to .env and update with your actual values

# Application
APP_NAME=LeadFlow AI
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Security
SECRET_KEY=change-me-to-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadflow
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Email Provider (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here

# SMTP Email (Fallback)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=hello@nanowareai.in
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=hello@nanowareai.in
SMTP_FROM_NAME=LeadFlow AI
SMTP_USE_TLS=true

# AI Provider
DEFAULT_AI_PROVIDER=bedrock

# Amazon Bedrock (Nova Micro)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0

# OpenRouter (fallback)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3-haiku

# Crawler
CRAWLER_USER_AGENT=LeadFlow AI Bot (+https://leadflow.ai/bot)
CRAWLER_REQUEST_TIMEOUT=30
CRAWLER_MAX_DEPTH=3
CRAWLER_CONCURRENT_REQUESTS=5

# Google Maps
GOOGLE_MAPS_API_KEY=

# Playwright
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true

# Email Settings
EMAIL_DAILY_LIMIT=100
EMAIL_REPLY_TRACKING_ENABLED=true
EMAIL_REPLY_TRACKING_DOMAIN=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
